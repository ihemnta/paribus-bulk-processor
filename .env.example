APP_NAME=Paribus Bulk Processor
APP_ENV=local
LOG_LEVEL=INFO

UPSTREAM_BASE_URL=https://hospital-directory.onrender.com
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_CONNECTIONS=5
WORKER_LEASE_SECONDS=120
ADMIN_API_KEY= # generate using openssl rand -hex 32

MAX_CSV_BYTES=1048576

DATABASE_URL=postgresql+asyncpg://paribus:paribus_dev_password@127.0.0.1:5433/paribus_bulk
ENABLE_REAL_UPSTREAM_WRITES=false
WORKER_POLL_SECONDS=2